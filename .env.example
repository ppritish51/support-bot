# --- LLM (generation) ---
ANTHROPIC_API_KEY=sk-ant-...
# Generation model. Default is Haiku 4.5 (cheapest, right for a high-volume deflector).
# Bump to claude-sonnet-5 or claude-opus-4-8 for higher quality.
GEN_MODEL=claude-haiku-4-5

# --- Embeddings (OpenAI) ---
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small
# MUST match your Pinecone index dimension. text-embedding-3-* can emit any size.
# Native is 1536; set 1024 if your index was created at 1024.
EMBED_DIM=1536

# --- Vector store (Pinecone) ---
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=support-deflector
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Retrieval / guardrail tuning ---
TOP_K=4
CONF_HIGH=0.50          # top cited score >= this -> High
CONF_MEDIUM=0.35        # >= this and < CONF_HIGH -> Medium; below -> Low
MAX_AGENT_ITERS=4
